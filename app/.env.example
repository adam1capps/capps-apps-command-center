# Capps Apps Command Center — env var reference.
# Copy to .env.local for local dev. Production values live in Netlify env.

# --- Database (Netlify-Neon extension auto-injects in production) ---
NETLIFY_DATABASE_URL=
NETLIFY_DATABASE_URL_UNPOOLED=

# --- Clerk auth (Phase 5) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- GitHub Contents API (Phase 4 + 10) ---
GITHUB_TOKEN=

# --- Webhook security (Phase 11, 12) ---
CAPPSHUB_WEBHOOK_SECRET=
CAPPSHUB_HOOK_TOKEN=

# --- Manual poller trigger (Phase 4) ---
X_TRIGGER_TOKEN=
